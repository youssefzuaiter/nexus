datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String   @default("Youssef Zuaiter")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile     UserProfile?
  projects    Project[]
  notes       Note[]
  tasks       Task[]
  events      Event[]
  links       EntityLink[]
  embeddings  WorkspaceEmbedding[]
  telemetry   FocusTelemetry[]
  auditLogs   AuditEvent[]
  calendars   CalendarSubscription[]
  flashcards  Flashcard[]
  courses     Course[]
  assessments Assessment[]
  noteVersions NoteVersion[]
}

model UserProfile {
  id         String @id @default(uuid())
  userId     String @unique
  university String @default("Example University")
  program    String @default("AI Engineering")
  studentId  String @default("000000")

  // Focus tracking is behavioural data, so it is off unless explicitly enabled
  // and the server refuses to record anything while this is false.
  focusTrackingEnabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id        String    @id @default(uuid())
  userId    String
  title     String
  category  String
  progress  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  Note[]
  tasks  Task[]
  events Event[]

  @@index([userId])
}

model Note {
  id         String    @id @default(uuid())
  userId     String
  projectId  String?
  courseId   String?
  title      String
  content    String    @db.Text
  tags       String[]
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tasks      Task[]
  flashcards Flashcard[]
  versions   NoteVersion[]

  @@index([userId])
}

model Task {
  id               String    @id @default(uuid())
  userId           String
  projectId        String?
  courseId         String?
  noteId           String?
  title            String
  description      String?
  status           String    @default("todo")
  priority         String    @default("medium")
  tags             String[]
  dueDate          DateTime?
  estimatedMinutes Int       @default(60)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  completedAt      DateTime?
  // Shared by every occurrence generated from the same "repeats" request.
  // Null means the task is a one-off. There is no separate rule row — the
  // occurrences are materialized once at creation, see lib/recurrence.ts.
  recurrenceId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dueDate])
  @@index([recurrenceId])
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  courseId    String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  // Shared by every occurrence generated from the same "repeats" request.
  // Null means the event is a one-off — see the matching Task field.
  recurrenceId String?
  // Set only on events materialized from an imported calendar feed. The pair
  // (subscriptionId, externalUid) is the idempotency key that makes re-syncing
  // the same feed update rows instead of duplicating them.
  subscriptionId String?
  externalUid    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course       Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subscription CalendarSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, externalUid])
  @@index([userId])
  @@index([startTime])
  @@index([recurrenceId])
}

/// An imported .ics feed (a university timetable, typically). The URL is
/// re-fetched on demand rather than by a background job: this app has no job
/// runner, and a timetable changes a handful of times a term.
model CalendarSubscription {
  id           String    @id @default(uuid())
  userId       String
  name         String
  url          String
  lastSyncedAt DateTime?
  lastEventCount Int     @default(0)
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([userId])
}

/// A spaced-repetition card generated from a note. Scheduling follows SM-2:
/// `easeFactor` and `intervalDays` are the algorithm's state, `dueAt` is the
/// derived next review date the queue reads.
model Flashcard {
  id           String    @id @default(uuid())
  userId       String
  noteId       String?
  question     String    @db.Text
  answer       String    @db.Text
  easeFactor   Float     @default(2.5)
  intervalDays Int       @default(0)
  repetitions  Int       @default(0)
  dueAt        DateTime  @default(now())
  lastReviewed DateTime?
  createdAt    DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

/// A taught course. The hub that ties a term's timetable events, notes, tasks
/// and marks together, so "what is due in CMP2003" is a query rather than a tag
/// convention. Deleting one detaches its contents rather than cascading, for
/// the same reason Project does.
model Course {
  id        String    @id @default(uuid())
  userId    String
  code      String
  title     String
  term      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  tasks       Task[]
  events      Event[]
  assessments Assessment[]

  @@index([userId])
}

/// One graded component of a course. `weight` is its share of the final mark in
/// percent; `score`/`maxScore` is what was earned, and stays null until it is
/// marked.
model Assessment {
  id        String    @id @default(uuid())
  userId    String
  courseId  String
  title     String
  weight    Float
  score     Float?
  maxScore  Float     @default(100)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

/// A snapshot of a note taken before each save. The editor replaces content
/// wholesale, so without this one bad paste plus a save is unrecoverable.
model NoteVersion {
  id        String   @id @default(uuid())
  userId    String
  noteId    String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

model EntityLink {
  id         String   @id @default(uuid())
  userId     String
  sourceType String
  sourceId   String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model WorkspaceEmbedding {
  id           String                      @id @default(uuid())
  userId       String
  sourceType   String
  sourceId     String
  contentChunk String                      @db.Text
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceType, sourceId])
}

model FocusTelemetry {
  id              String   @id @default(uuid())
  userId          String
  sessionDuration Int
  typingSpeedWpm  Int
  cognitiveLoad   String
  recordedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String
  actorType  String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
